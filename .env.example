# ShareSphere Environment Configuration

# Application Environment (development, production)
ENVIRONMENT=development

# Database Connection (SQLite fallback default, or PostgreSQL URI)
DATABASE_URL=sqlite:///./backend/sharesphere.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sharesphere

# JWT Authentication Secret Key
JWT_SECRET=sharesphere_super_secret_hackathon_jwt_key_2026

# Optional: Google Gemini API Key for Enhanced Natural-Language Analysis
# (System automatically falls back to deterministic explainable matching if omitted)
GEMINI_API_KEY=

# Server Binding
HOST=127.0.0.1
PORT=8000
